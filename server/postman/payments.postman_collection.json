    {
      "name": "4. An orders food on booking 3 (unpaid QR payment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Pending with an unpaid QR payment', () => {",
              "  pm.expect(data.status).to.eql('pending');",
              "  pm.expect(data.payment.status).to.eql('unpaid');",
              "  pm.expect(data.payment.method).to.eql('e_wallet');",
              "  pm.expect(data.payment.amount).to.eql(data.total_price);",
              "  pm.expect(data.payment.seconds_left).to.be.within(1, 900);",
              "  pm.expect(data.payment.expires_at).to.match(/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$/);",
              "  pm.expect(data.payment.invoice_number).to.eql(null);",
              "});",
              "pm.collectionVariables.set('foodOrderId', data.id);",
              "pm.collectionVariables.set('foodPaymentId', data.payment.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Creating an order also creates its QR payment in the same transaction. Expected: 201, status pending, payment.status unpaid, payment.method e_wallet, payment.amount 150000 (= total_price), expires_at 15 minutes after created_at, seconds_left from 1 to 900, invoice_number null. The ids are saved to foodOrderId and foodPaymentId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/food-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"items\": [\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      }
    },
