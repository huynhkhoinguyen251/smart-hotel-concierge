      "name": "9. An pays the food order (\"I have paid\")",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Paid with invoice, order still pending', () => {",
              "  pm.expect(data.status).to.eql('paid');",
              "  pm.expect(data.invoice_number).to.match(/^INV-\\d{8}-\\d{6}$/);",
              "  pm.expect(data.expires_at).to.eql(null);",
              "  pm.expect(data.seconds_left).to.eql(null);",
              "  pm.expect(data.target.type).to.eql('food_order');",
              "  pm.expect(String(data.target.id)).to.eql(String(pm.collectionVariables.get('foodOrderId')));",
              "  pm.expect(data.order_status).to.eql('pending');",
              "});"
            ]
          }
        }
      ],
