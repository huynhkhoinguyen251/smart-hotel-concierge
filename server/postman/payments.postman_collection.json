{
  "info": {
    "name": "Smart Hotel - Payments",
    "description": "Tests the simulated QR payment and invoice APIs (section 11 of docs/api.md, Option A). Run the requests in order (Collection Runner). The test food order and the test booking end as cancelled with refunded payments, so the collection can be run again. Request 4 uses seed booking 3, which is checked in until 6 Dec 2026; the dates in March 2027 work until then. Expiry (15 minutes) is not tested here; see docs/api.md section 11 for a quick manual test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
