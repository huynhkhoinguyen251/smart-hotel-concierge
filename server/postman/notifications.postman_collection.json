        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/999999/read"
      }
    },
    {
      "name": "13. An marks all notifications as read",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Nothing unread', () => pm.expect(pm.response.json().unread_count).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'All notifications marked as read', unread_count 0.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/read-all"
      }
    },
    {
      "name": "14. An sends a support request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ticketId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Every active admin gets a \"New support request\" notification. Expected: 201. The id is saved to ticketId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Extra towels\",\n  \"message\": \"Could I have two extra towels, please?\"\n}"
        }
      }
    },
    {
      "name": "15. Admin replies to the support request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201. An gets a \"Reception replied\" notification.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Housekeeping is on the way.\"\n}"
        }
      }
    },
    {
      "name": "16. An sees the reply notification",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Reception replied', () => {",
              "  pm.expect(body.data[0].title).to.eql('Reception replied');",
              "  pm.expect(body.data[0].type).to.eql('support');",
              "  pm.expect(body.data[0].link_path).to.eql('/support/' + pm.collectionVariables.get('ticketId'));",
              "  pm.expect(body.unread_count).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. The newest is 'Reception replied' (type support, link_path /support/{ticketId}) and unread_count is 1.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications?limit=1"
      }
    },
    {
      "name": "17. Admin resolves the support request (cleanup)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. An gets a \"Support request resolved\" notification.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}"
        }
      }
    },
    {
      "name": "18. Admin cancels the food order (cleanup, refunded)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. An gets \"Food order cancelled\" with \"Your payment has been refunded.\"",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/food-orders/{{foodOrderId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\"\n}"
        }
      }
    },
    {
      "name": "19. An sees the cancellation with refund",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const n = pm.response.json().data[0];",
              "pm.test('Cancelled and refunded', () => {",
              "  pm.expect(n.title).to.eql('Food order cancelled');",
              "  pm.expect(n.message).to.include('Your payment has been refunded.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. The newest is 'Food order cancelled' and its message ends with 'Your payment has been refunded.'",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications?limit=1"
      }
    }
