              "pm.collectionVariables.set('chiToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as chi.pham@example.com (test account from database/README.md). Expected: 200. The token is saved to chiToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"chi.pham@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "3. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "4. An orders food on booking 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('foodOrderId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Creates a food order to trigger notifications. Creating an order does not notify the guest. Expected: 201. The id is saved to foodOrderId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/food-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"items\": [\n    {\n      \"menu_item_id\": 6,\n      \"quantity\": 1\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "5. An pays the food order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "description": "The payment creates two notifications in the same transaction: \"Payment received, waiting for confirmation\" for An and \"Food order waiting for confirmation\" for every active admin. Expected: 200.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"method\": \"e_wallet\",\n  \"food_order_id\": {{foodOrderId}}\n}"
        }
      }
    },
    {
      "name": "6. Admin lists unread notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Unread only, with unread_count', () => {",
              "  body.data.forEach((n) => pm.expect(n.is_read).to.eql(false));",
              "  pm.expect(typeof body.unread_count).to.eql('number');",
              "});",
              "pm.test('Waiting for confirmation', () => {",
              "  pm.expect(body.data[0].title).to.eql('Food order waiting for confirmation');",
              "  pm.expect(body.data[0].link_path).to.eql('/admin/food-orders/' + pm.collectionVariables.get('foodOrderId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, newest first, every item unread, unread_count at the top level of the response. The first one is 'Food order waiting for confirmation' with link_path /admin/food-orders/{foodOrderId}.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications?unread_only=true&limit=5"
      }
    },
    {
      "name": "7. Admin confirms the food order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. An gets a \"Food order confirmed\" notification.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/food-orders/{{foodOrderId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\"\n}"
        }
      }
    },
    {
      "name": "8. An lists notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Food order confirmed', () => {",
              "  pm.expect(body.data[0].title).to.eql('Food order confirmed');",
              "  pm.expect(body.data[0].type).to.eql('food_order');",
              "  pm.expect(body.data[0].link_path).to.eql('/my-food-orders/' + pm.collectionVariables.get('foodOrderId'));",
              "  pm.expect(body.data[0].is_read).to.eql(false);",
              "  pm.expect(body.data[1].title).to.eql('Payment received, waiting for confirmation');",
              "  pm.expect(body.unread_count).to.be.at.least(2);",
              "});",
              "pm.collectionVariables.set('notificationId', body.data[0].id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination and unread_count. The newest is 'Food order confirmed' (type food_order, link_path /my-food-orders/{foodOrderId}, is_read false); the one before is 'Payment received, waiting for confirmation'. Its id is saved to notificationId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications?limit=5"
      }
    },
    {
      "name": "9. An lists only unread notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('All unread, total = unread_count', () => {",
              "  body.data.forEach((n) => pm.expect(n.is_read).to.eql(false));",
              "  pm.expect(body.pagination.total).to.eql(body.unread_count);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every item is unread and pagination.total equals unread_count.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications?unread_only=true&limit=50"
      }
    },
    {
      "name": "10. An marks one notification as read",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Read', () => pm.expect(pm.response.json().data.is_read).to.eql(true));",
              "pm.test('Has unread_count', () => pm.expect(typeof pm.response.json().unread_count).to.eql('number'));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'Notification marked as read', data.is_read true and the new unread_count at the top level. Calling it again also returns 200.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
      }
    },
    {
      "name": "11. Chi marks An's notification as read (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"You do not have permission to access this notification\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 403 with message 'You do not have permission to access this notification'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{chiToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
      }
    },
    {
      "name": "12. Mark a missing notification as read (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Notification not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 404 with message 'Notification not found'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
