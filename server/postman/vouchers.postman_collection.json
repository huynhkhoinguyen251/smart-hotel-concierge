            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/vouchers",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"PM-EXPIRED\",\n  \"discount_type\": \"fixed\",\n  \"discount_value\": 10000,\n  \"min_amount\": 0,\n  \"max_uses\": null,\n  \"starts_at\": \"2026-01-01 00:00:00\",\n  \"ends_at\": \"2026-01-31 23:59:59\",\n  \"is_active\": true\n}"
        }
      }
