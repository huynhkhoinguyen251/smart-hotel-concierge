      "name": "10. An books room 1 with WELCOME10 (15 Mar - 17 Mar 2027)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('Discount, total and payment', () => {",
              "  pm.expect(d.discount_amount).to.eql(160000);",
              "  pm.expect(d.total_price).to.eql(1440000);",
              "  pm.expect(d.voucher.code).to.eql('WELCOME10');",
              "  pm.expect(d.payment.amount).to.eql(1440000);",
              "});",
              "pm.collectionVariables.set('bookingId', d.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Subtotal 1,600,000 (2 nights x 800,000). Expected: 201, discount_amount 160000, total_price 1440000, voucher { code WELCOME10 }, payment.amount 1440000. The id is saved to bookingId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
