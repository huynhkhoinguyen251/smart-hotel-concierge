{
  "info": {
    "name": "Smart Hotel - Vouchers",
    "description": "Tests voucher validation, vouchers on room bookings and food orders, and the 4 admin voucher APIs (section 12 of docs/api.md). Run the requests in order (Collection Runner). The test orders end as cancelled (their uses are given back) and the test vouchers are deleted, so the collection can be run again. Request 15 uses seed booking 3, which is checked in until 6 Dec 2026; WELCOME10 is valid until 31 Jan 2027 and FOOD50K until 31 Dec 2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
