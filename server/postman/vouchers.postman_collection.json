    {
      "name": "4. Validate WELCOME10 on 1,600,000 VND",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('10% of 1,600,000', () => {",
              "  pm.expect(d.code).to.eql('WELCOME10');",
              "  pm.expect(d.discount_amount).to.eql(160000);",
              "  pm.expect(d.total_after_discount).to.eql(1440000);",
              "  pm.expect(d.min_amount).to.eql(1000000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Codes are trimmed and upper-cased. Expected: 200, code WELCOME10, discount_type percent, discount_value 10, discount_amount 160000, total_after_discount 1440000, min_amount 1000000, ends_at. No use is reserved.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/vouchers/validate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \" welcome10 \",\n  \"amount\": 1600000\n}"
        }
      }
    },
