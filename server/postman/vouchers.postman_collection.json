      "name": "3. Admin creates an expired test voucher",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "pm.test('Expired', () => pm.expect(pm.response.json().data.status).to.eql('expired'));",
              "pm.collectionVariables.set('expiredId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Creates PM-EXPIRED (ended 31 Jan 2026) to test the 'expired' message. Expected: 201, status expired. The id is saved to expiredId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
