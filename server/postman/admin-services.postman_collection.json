{
  "info": {
    "name": "Smart Hotel - Admin Hotel Services",
    "description": "Tests the 4 admin service APIs and the 3 admin service request APIs. Run the requests in order (Collection Runner). The test service is deleted at the end of the CRUD steps, and each run adds one completed service request, so the collection can be run again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "2. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "3. List all services",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Has is_active', () => pm.response.json().data.forEach((service) => pm.expect(typeof service.is_active).to.eql('boolean')));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination. Includes inactive services, and every service has is_active, created_at and updated_at.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/services?limit=50"
      }
    },
    {
      "name": "4. Filter services (category=massage, is_active=true)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Active massage only', () => pm.response.json().data.forEach((service) => {",
              "  pm.expect(service.category).to.eql('massage');",
              "  pm.expect(service.is_active).to.eql(true);",
              "}));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every service is an active massage service.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/services?category=massage&is_active=true"
      }
    },
    {
      "name": "5. Create a service",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Active, price 750000', () => {",
              "  pm.expect(data.is_active).to.eql(true);",
              "  pm.expect(data.price).to.eql(750000);",
              "});",
              "pm.collectionVariables.set('serviceId', data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Service created successfully'. is_active is true by default and price is 750000. The id is saved to serviceId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Hot stone massage\",\n  \"category\": \"massage\",\n  \"description\": \"90-minute massage with warm basalt stones.\",\n  \"price\": 750000,\n  \"image_url\": \"https://placehold.co/800x600?text=Hot+Stone\"\n}"
        }
      }
    },
    {
      "name": "6. Create with invalid data (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "description": "Empty name, unknown category and negative price. Expected: 400.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"category\": \"spa\",\n  \"price\": -1\n}"
        }
      }
    },
    {
      "name": "7. Update the service (full update)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Updated and inactive', () => {",
              "  pm.expect(data.price).to.eql(800000);",
              "  pm.expect(data.is_active).to.eql(false);",
              "  pm.expect(data.description).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "PUT replaces all fields. Here is_active is false and description is not sent, so it becomes null. Expected: 200, message 'Service updated successfully'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Hot stone massage (90 minutes)\",\n  \"category\": \"massage\",\n  \"price\": 800000,\n  \"is_active\": false\n}"
        }
      }
    },
    {
      "name": "8. Public API hides the inactive service (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Service not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "The service from request 5 is now inactive. Expected: 404 with message 'Service not found'.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/services/{{serviceId}}"
      }
    },
