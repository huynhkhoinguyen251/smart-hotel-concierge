    {
      "name": "15. List pending service requests",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All pending with user', () => data.forEach((item) => {",
              "  pm.expect(item.status).to.eql('pending');",
              "  pm.expect(typeof item.user.email).to.eql('string');",
              "}));",
              "pm.test('Contains requestId', () => pm.expect(data.map((item) => String(item.id))).to.include(String(pm.collectionVariables.get('requestId'))));"
            ]
          }
        }
