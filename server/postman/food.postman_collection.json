      "name": "17. List my food orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Contains orderId', () => pm.expect(data.map((order) => String(order.id))).to.include(String(pm.collectionVariables.get('orderId'))));",
