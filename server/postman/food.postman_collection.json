{
  "info": {
    "name": "Smart Hotel - Food and Drink",
    "description": "Tests the 2 public menu APIs and the 4 user food order APIs. Run the requests in order (Collection Runner). Each run adds two food orders on seed booking 3 (one is cancelled at the end), so the collection can be run again while booking 3 is checked in (until 6 Dec 2026).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "2. List the menu",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Has pagination', () => pm.expect(body.pagination.page).to.eql(1));",
              "pm.test('Item 5 is hidden', () => pm.expect(body.data.map((item) => item.id)).to.not.include(5));",
              "pm.test('Prices are numbers', () => body.data.forEach((item) => pm.expect(typeof item.price).to.eql('number')));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public, no login. Expected: 200 with pagination. Only available items are listed, so seed item 5 (Goi Cuon) is not in the list. Prices are numbers. The seed data has 9 available items.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items?limit=50"
      }
    },
    {
      "name": "3. Filter the menu by category (coffee)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All coffee', () => data.forEach((item) => pm.expect(item.category).to.eql('coffee')));",
              "pm.test('Contains items 6, 7, 8', () => pm.expect(data.map((item) => item.id)).to.include.members([6, 7, 8]));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200. Every item has category coffee. Seed items 6, 7 and 8 are in the list.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items?category=coffee"
      }
    },
    {
      "name": "4. Filter by an unknown category (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Category must be one of: food, coffee, drink\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Category must be one of: food, coffee, drink'.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items?category=dessert"
      }
    },
    {
      "name": "5. Get menu item 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Price 75000', () => pm.expect(pm.response.json().data.price).to.eql(75000));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200, message 'Menu item retrieved successfully'. Pho Bo, price 75000.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items/1"
      }
    },
    {
      "name": "6. Get unavailable item 5 (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Menu item not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Seed item 5 (Goi Cuon) has is_available = false, so the public API treats it as missing. Expected: 404 with message 'Menu item not found'.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items/5"
      }
    },
    {
      "name": "7. Order Pho Bo x2 and orange juice x1 on booking 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Pending, total 200000', () => {",
              "  pm.expect(data.status).to.eql('pending');",
              "  pm.expect(data.total_price).to.eql(200000);",
              "  pm.expect(data.discount_amount).to.eql(0);",
              "  pm.expect(data.can_cancel).to.eql(true);",
              "});",
              "pm.test('Two items with line totals', () => {",
              "  pm.expect(data.items.length).to.eql(2);",
              "  pm.expect(data.items[0].menu_item.id).to.eql(1);",
              "  pm.expect(data.items[0].unit_price).to.eql(75000);",
              "  pm.expect(data.items[0].line_total).to.eql(150000);",
              "  pm.expect(data.items[1].line_total).to.eql(50000);",
              "});",
              "pm.collectionVariables.set('orderId', data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Booking 3 belongs to An and is checked_in (6 Nov - 6 Dec 2026). Expected: 201, message 'Food order placed successfully', status pending, total_price 200000 (75000 x 2 + 50000 x 1), discount_amount 0, 2 items with line totals 150000 and 50000. The id is saved to orderId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/food-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"items\": [\n    {\n      \"menu_item_id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menu_item_id\": 9,\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"Less spicy, please.\"\n}"
        }
      }
    },
    {
      "name": "8. Send a price in the body (ignored)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Price from the database', () => {",
              "  pm.expect(data.items[0].unit_price).to.eql(35000);",
              "  pm.expect(data.total_price).to.eql(70000);",
              "  pm.expect(data.status).to.eql('pending');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "The body contains unit_price 1, total_price 1 and status completed. The server ignores them. Expected: 201 with unit_price 35000 (from the database), total_price 70000 and status pending.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/food-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"items\": [\n    {\n      \"menu_item_id\": 6,\n      \"quantity\": 2,\n      \"unit_price\": 1\n    }\n  ],\n  \"total_price\": 1,\n  \"status\": \"completed\"\n}"
        }
      }
    },
