            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Limit must be an integer from 1 to 20\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Limit must be an integer from 1 to 20'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/stats/top-rooms?limit=21"
      }
    },
    {
      "name": "10. Top rooms with the default limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('At most 5', () => pm.expect(pm.response.json().data.length <= 5).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with at most 5 rooms.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/stats/top-rooms"
      }
    },
    {
      "name": "11. Top services",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('At most 5', () => pm.expect(data.length <= 5).to.eql(true));",
              "pm.test('Sorted by usage_count', () => data.forEach((item, i) => { if (i > 0) pm.expect(data[i - 1].usage_count >= item.usage_count).to.eql(true); }));",
              "pm.test('Item shape', () => data.forEach((item) => {",
              "  pm.expect(Object.keys(item.service).sort()).to.eql(['category', 'id', 'name']);",
              "  pm.expect(typeof item.revenue).to.eql('number');",
              "}));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. At most 5 services, sorted by usage_count from high to low. usage_count includes hotel service requests and transport bookings. Each item has service { id, name, category }, usage_count and revenue.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/stats/top-services"
      }
    },
    {
      "name": "12. Feedback",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All five ratings', () => pm.expect(Object.keys(data.by_rating)).to.eql(['1', '2', '3', '4', '5']));",
              "pm.test('All five types', () => pm.expect(data.by_type.map((item) => item.type)).to.eql(['room', 'service', 'food_order', 'tour', 'transport']));",
              "pm.test('Counts add up', () => pm.expect(Object.values(data.by_rating).reduce((a, b) => a + b, 0)).to.eql(data.review_count));",
              "pm.test('Average is a number', () => pm.expect(typeof data.average_rating).to.eql('number'));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. average_rating, review_count, by_rating with all five keys \"1\" to \"5\", and by_type with room, service, food_order, tour and transport.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
