              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Limit must be an integer from 1 to 20\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Limit must be an integer from 1 to 20'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/stats/top-rooms?limit=0"
      }
    },
