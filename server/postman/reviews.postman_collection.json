{
  "info": {
    "name": "Smart Hotel - Reviews",
    "description": "Tests the 2 user review APIs and the 4 public review lists. Run the requests in order (Collection Runner). Each run creates a new tour booking, completes it as the admin and reviews it, so the collection can be run again. Service booking 2 and transport booking 1 are never used, so they stay unreviewed for the demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tourBookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "2. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "3. An books tour 4 for 1 person",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('tourBookingId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Creates a new tour booking to review, so the collection can be run again. Expected: 201. The id is saved to tourBookingId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tour-bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tour_id\": 4,\n  \"tour_date\": \"2026-12-20\",\n  \"participants\": 1\n}"
        }
      }
    },
    {
      "name": "4. Admin changes the tour booking to confirmed",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Status confirmed', () => pm.expect(pm.response.json().data.status).to.eql('confirmed'));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, status confirmed.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tour-bookings/{{tourBookingId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\"\n}"
        }
      }
    },
