    {
      "name": "20. List my reviews",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Newest first', () => pm.expect(String(data[0].id)).to.eql(String(pm.collectionVariables.get('reviewId'))));",
              "pm.test('Target names', () => {",
              "  const names = Object.fromEntries(data.map((item) => [item.id, item.target.name]));",
              "  pm.expect(names[1]).to.eql('Room 101');",
              "  pm.expect(names[3]).to.eql('Restaurant breakfast');",
              "  pm.expect(names[4]).to.eql('Food order #1');",
              "  pm.expect(names[5]).to.eql('Hoi An Ancient Town by Night');",
              "});",
              "pm.test('Only my reviews', () => pm.expect(data.map((item) => item.id)).to.not.include(2));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination, newest first. Each review has a target with type, id and name: Room 101 (review 1), Restaurant breakfast (review 3), Food order #1 (review 4), Hoi An Ancient Town by Night (review 5), and the new tour review first.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/reviews?limit=50"
