    {
      "name": "7. Review the completed tour booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Rating, comment and target', () => {",
              "  pm.expect(data.rating).to.eql(5);",
              "  pm.expect(data.comment).to.eql('Great views from the top of Thuy Son.');",
              "  pm.expect(data.target.type).to.eql('tour');",
              "  pm.expect(String(data.target.id)).to.eql(String(pm.collectionVariables.get('tourBookingId')));",
              "  pm.expect(data.target.name).to.eql('Marble Mountains and Non Nuoc Beach');",
              "});",
              "pm.collectionVariables.set('reviewId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Review created successfully', rating 5, comment trimmed, target { type tour, id tourBookingId, name Marble Mountains and Non Nuoc Beach }. The id is saved to reviewId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tour_booking_id\": \"{{tourBookingId}}\",\n  \"rating\": 5,\n  \"comment\": \"  Great views from the top of Thuy Son.  \"\n}"
        }
      }
    },
