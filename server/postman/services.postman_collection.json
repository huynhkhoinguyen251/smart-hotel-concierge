{
  "info": {
    "name": "Smart Hotel - Hotel Services",
    "description": "Tests the 2 public service APIs and the 4 user service request APIs. Run the requests in order (Collection Runner). Each run adds a few new service requests, so the collection can be run again. Request 7 (housekeeping on booking 3) works until 5 Dec 2026 10:00, while seed booking 3 is still checked in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "massageRequestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "2. List active services",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Has pagination', () => pm.expect(body.pagination.page).to.eql(1));",
              "pm.test('Prices are numbers', () => body.data.forEach((service) => pm.expect(typeof service.price).to.eql('number')));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public, no login. Expected: 200 with pagination. Only active services are listed, and prices are numbers. The seed data has 8 active services.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/services?limit=50"
      }
    },
    {
      "name": "3. Filter services by category (massage)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All massage', () => data.forEach((service) => pm.expect(service.category).to.eql('massage')));",
              "pm.test('Contains service 3', () => pm.expect(data.map((service) => service.id)).to.include(3));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200. Every service has category massage. Seed service 3 (60-minute relaxing massage) is in the list.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/services?category=massage"
      }
    },
    {
      "name": "4. Filter by an unknown category (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400. The category must be one of the 8 values in the database: breakfast, buffet, massage, laundry, housekeeping, motorbike_rental, airport_pickup, shuttle.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/services?category=spa"
      }
    },
    {
      "name": "5. Get service 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Price 150000', () => pm.expect(pm.response.json().data.price).to.eql(150000));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200, message 'Service retrieved successfully'. Restaurant breakfast, price 150000.",
        "auth": {
          "type": "noauth"
