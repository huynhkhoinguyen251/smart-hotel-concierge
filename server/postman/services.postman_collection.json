        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/services/99999"
      }
    },
    {
      "name": "7. Book housekeeping on booking 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Pending, total 100000', () => {",
              "  pm.expect(data.status).to.eql('pending');",
              "  pm.expect(data.unit_price).to.eql(100000);",
              "  pm.expect(data.total_price).to.eql(100000);",
              "  pm.expect(data.service.category).to.eql('housekeeping');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Booking 3 belongs to An and is checked_in (6 Nov - 6 Dec 2026). Housekeeping needs a checked-in booking. Expected: 201, message 'Service request created successfully', status pending, unit_price 100000 (from the database), total_price 100000. This request works until 5 Dec 2026 10:00, because scheduled_at must be in the future and within the stay.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/service-bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"service_id\": 5,\n  \"scheduled_at\": \"2026-12-05 10:00\",\n  \"quantity\": 1,\n  \"note\": \"Please bring extra towels.\"\n}"
        }
      }
    },
