{
  "info": {
    "name": "Smart Hotel - Support Tickets",
    "description": "Tests the 4 user support ticket APIs. Run the requests in order (Collection Runner). Each run creates one new open ticket with two messages, so the collection can be run again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "2. Create a support ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Open with one message', () => {",
              "  pm.expect(data.status).to.eql('open');",
              "  pm.expect(data.subject).to.eql('Extra pillows for room 301');",
              "  pm.expect(data.message_count).to.eql(1);",
              "  pm.expect(data.messages.length).to.eql(1);",
              "  pm.expect(data.messages[0].message).to.eql('Could we have two extra pillows tonight, please?');",
              "  pm.expect(data.messages[0].sender.id).to.eql(2);",
              "  pm.expect(data.messages[0].sender.role).to.eql('user');",
              "});",
              "pm.test('No password_hash or email in messages', () => {",
              "  const text = JSON.stringify(pm.response.json());",
              "  pm.expect(text.includes('password_hash')).to.eql(false);",
              "  pm.response.json().data.messages.forEach((m) => pm.expect(Object.keys(m.sender).sort()).to.eql(['full_name', 'id', 'role']));",
              "});",
              "pm.collectionVariables.set('ticketId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Support ticket created successfully', status open, message_count 1, and one message sent by An (role user). Subject and message are trimmed. The id is saved to ticketId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"  Extra pillows for room 301  \",\n  \"message\": \"  Could we have two extra pillows tonight, please?  \"\n}"
        }
      }
    },
    {
      "name": "3. Create with an empty subject (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Subject is required\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "A subject with only spaces is empty after trimming. Expected: 400 with message 'Subject is required'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"   \",\n  \"message\": \"Hello\"\n}"
        }
      }
    },
    {
      "name": "4. Create with a subject longer than 200 characters (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Subject must be at most 200 characters\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Subject must be at most 200 characters'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\n  \"message\": \"Hello\"\n}"
        }
      }
    },
    {
      "name": "5. Create without a message (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Message is required\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Message is required'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"No message\"\n}"
        }
      }
    },
    {
      "name": "6. Create with a message longer than 2000 characters (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Message must be at most 2000 characters\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Message must be at most 2000 characters'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Long message\",\n  \"message\": \"\"\n}"
        }
      }
    },
    {
      "name": "7. List my tickets",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Contains ticketId', () => pm.expect(data.map((item) => String(item.id))).to.include(String(pm.collectionVariables.get('ticketId'))));",
              "pm.test('Contains ticket 1, not 2 or 3', () => {",
              "  const ids = data.map((item) => item.id);",
              "  pm.expect(ids).to.include(1);",
              "  pm.expect(ids).to.not.include(2);",
              "  pm.expect(ids).to.not.include(3);",
              "});",
              "pm.test('Counts and no messages', () => data.forEach((item) => {",
              "  pm.expect(typeof item.message_count).to.eql('number');",
              "  pm.expect(typeof item.last_message_at).to.eql('string');",
              "  pm.expect(item).to.not.have.property('messages');",
              "}));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination, most recently updated first. Only An's tickets: the new ticket and seed ticket 1 are in the list, and tickets 2 and 3 (other guests) are not. Each ticket has message_count and last_message_at, without messages.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets?limit=50"
      }
    },
    {
      "name": "8. Filter my tickets by status (in_progress)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All in_progress', () => data.forEach((item) => pm.expect(item.status).to.eql('in_progress')));",
              "pm.test('Contains ticket 1', () => pm.expect(data.map((item) => item.id)).to.include(1));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every ticket is in_progress. Seed ticket 1 is in the list.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets?status=in_progress&limit=50"
      }
    },
    {
      "name": "9. Filter by an unknown status (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Status must be one of: open, in_progress, resolved\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Status must be one of: open, in_progress, resolved'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets?status=closed"
      }
    },
    {
      "name": "10. Get my ticket 1 with messages",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Messages in order', () => {",
              "  pm.expect(data.messages[0].id).to.eql(1);",
              "  pm.expect(data.messages[0].sender.role).to.eql('user');",
              "  pm.expect(data.messages[1].sender.role).to.eql('admin');",
              "  pm.expect(data.messages[1].sender.full_name).to.eql('Nguyen Minh Quan');",
              "});",
              "pm.test('No password_hash or email in messages', () => {",
              "  const text = JSON.stringify(pm.response.json());",
              "  pm.expect(text.includes('password_hash')).to.eql(false);",
              "  pm.response.json().data.messages.forEach((m) => pm.expect(Object.keys(m.sender).sort()).to.eql(['full_name', 'id', 'role']));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'Support ticket retrieved successfully'. Messages oldest first: the first is from An (user), the second from the admin (role admin). Senders have only id, full_name and role.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets/1"
      }
    },
    {
      "name": "11. Add a message to my new ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Two messages, still open', () => {",
              "  pm.expect(data.message_count).to.eql(2);",
              "  pm.expect(data.messages[1].message).to.eql('Also one more blanket, please.');",
              "  pm.expect(data.status).to.eql('open');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Message sent successfully'. message_count becomes 2, the new message is last, and the status stays open.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Also one more blanket, please.\"\n}"
        }
      }
    },
    {
      "name": "12. Add an empty message (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Message is required\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 400 with message 'Message is required'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets/{{ticketId}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"\"\n}"
        }
      }
    },
    {
      "name": "13. Get another guest's ticket 2 (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"You do not have permission to access this support ticket\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Seed ticket 2 belongs to Le Van Binh. Expected: 403 with message 'You do not have permission to access this support ticket'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets/2"
      }
    },
    {
      "name": "14. Add a message to another guest's ticket 2 (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"You do not have permission to access this support ticket\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Ticket 2 is resolved and belongs to another guest; ownership is checked first. Expected: 403 with the same message.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets/2/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Hello\"\n}"
        }
      }
    },
    {
      "name": "15. Get a missing ticket (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Support ticket not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 404 with message 'Support ticket not found'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets/99999"
      }
    },
    {
      "name": "16. List tickets without a token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 401.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets"
      }
    }
  ]
}
