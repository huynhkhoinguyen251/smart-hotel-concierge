{
  "info": {
    "name": "Smart Hotel - Admin Users",
    "description": "Tests the 4 admin user management APIs. Run the requests in order (Collection Runner). Each run registers a new test user with a unique email, locks, unlocks and changes its role, and leaves it active with role user, so the collection can be run again.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "2. Register a new test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.collectionVariables.set('userId', data.user.id);",
              "pm.collectionVariables.set('userEmail', data.user.email);",
              "pm.collectionVariables.set('userToken', data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Uses a unique email with {{$timestamp}}, so the collection can be run again. Expected: 201. The user id, email and token are saved to userId, userEmail and userToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Test Guest\",\n  \"email\": \"test.guest.{{$timestamp}}@example.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"0905999999\"\n}"
        }
      }
    },
    {
      "name": "3. Log in as the test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('userToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "The test user logs in with the password used at registration. Expected: 200. The new token is saved to userToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test@1234\"\n}"
        }
      }
    },
    {
      "name": "4. Search users by the test email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Exactly the test user', () => {",
              "  pm.expect(body.pagination.total).to.eql(1);",
              "  pm.expect(String(body.data[0].id)).to.eql(String(pm.collectionVariables.get('userId')));",
              "});",
              "pm.test('No password_hash', () => pm.expect(JSON.stringify(pm.response.json()).includes('password_hash')).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "description": "search matches full_name, email or phone. Expected: 200, exactly one user: the test user, without password_hash.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/users?search={{userEmail}}"
      }
    },
    {
      "name": "5. Get the test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Active user', () => {",
              "  pm.expect(data.role).to.eql('user');",
              "  pm.expect(data.is_active).to.eql(true);",
              "  pm.expect(data.full_name).to.eql('Test Guest');",
              "});",
              "pm.test('No password_hash', () => pm.expect(JSON.stringify(pm.response.json()).includes('password_hash')).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'User retrieved successfully'. Role user, is_active true, no password_hash.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/users/{{userId}}"
      }
    },
    {
      "name": "6. Lock the test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('is_active false', () => pm.expect(pm.response.json().data.is_active).to.eql(false));",
              "pm.test('No password_hash', () => pm.expect(JSON.stringify(pm.response.json()).includes('password_hash')).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'User status updated successfully', is_active false.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/users/{{userId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        }
      }
    },
    {
      "name": "7. The old token is rejected at once (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Account is locked\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "The middleware reads the latest status from the database. Expected: 403 with message 'Account is locked'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "8. The locked user cannot log in (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Account is locked\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "The account is locked. Expected: 403 with message 'Account is locked'.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test@1234\"\n}"
        }
      }
    },
