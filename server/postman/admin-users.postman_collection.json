    {
      "name": "22. List users (no password_hash, newest first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('No password_hash in any item', () => data.forEach((user) => pm.expect(Object.keys(user)).to.not.include('password_hash')));",
              "pm.test('Newest first', () => pm.expect(data[0].created_at >= data[data.length - 1].created_at).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination. No item has password_hash, and the newest user comes first.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/users?limit=50"
      }
    },
    {
      "name": "23. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "24. User calls an admin API (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "description": "An is not an admin. Expected: 403.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/users"
      }
    }
  ]
