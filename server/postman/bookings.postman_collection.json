    {
      "name": "4. An books room 1 (10 Feb - 13 Feb 2027)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Pending, 3 nights, total 2400000', () => {",
              "  pm.expect(data.status).to.eql('pending');",
              "  pm.expect(data.nights).to.eql(3);",
              "  pm.expect(data.total_price).to.eql(2400000);",
              "  pm.expect(data.can_edit).to.eql(true);",
              "});",
              "pm.collectionVariables.set('bookingId', data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Booking created successfully'. status pending, nights 3, price_per_night 800000 (taken from the database), total_price 2400000, discount_amount 0, can_edit true, can_cancel true. The id is saved to bookingId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"room_id\": 1,\n  \"check_in\": \"2027-02-10\",\n  \"check_out\": \"2027-02-13\",\n  \"guests\": 2\n}"
        }
      }
    },
