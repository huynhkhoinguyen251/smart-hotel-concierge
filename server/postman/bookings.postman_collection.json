    {
      "name": "19. An books room 3 for today",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pad = (n) => String(n).padStart(2, \"0\");",
              "const format = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
              "const now = new Date();",
              "const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);",
              "pm.collectionVariables.set('today', format(now));",
              "pm.collectionVariables.set('tomorrow', format(tomorrow));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Today, cannot self-cancel', () => {",
              "  pm.expect(data.check_in).to.eql(pm.collectionVariables.get('today'));",
              "  pm.expect(data.can_cancel).to.eql(false);",
              "});",
              "pm.collectionVariables.set('todayBookingId', data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "The pre-request script saves today and tomorrow (computer's local time) to the variables today and tomorrow. Expected: 201, status pending, nights 1, can_cancel false (less than 24 hours before 14:00 today). The id is saved to todayBookingId. Earlier test bookings for room 3 are cancelled, so they do not block it.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"room_id\": 3,\n  \"check_in\": \"{{today}}\",\n  \"check_out\": \"{{tomorrow}}\",\n  \"guests\": 1\n}"
        }
      }
