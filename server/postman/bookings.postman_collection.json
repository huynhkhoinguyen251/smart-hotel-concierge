{
  "info": {
    "name": "Smart Hotel - Bookings",
    "description": "Tests the 5 user booking APIs and the 3 admin booking APIs. Run the requests in order (Collection Runner). Every test booking ends as cancelled, and cancelled bookings do not block rooms, so the collection can be run again. The fixed dates in February 2027 only work until then; after that, change them to future dates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
