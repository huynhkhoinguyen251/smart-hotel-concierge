{
  "info": {
    "name": "Smart Hotel - Admin Tourism",
    "description": "Tests the 4 admin tour APIs, the 3 admin tour booking APIs and the 3 admin transport booking APIs. Run the requests in order (Collection Runner). The test tour is deleted at the end of the CRUD steps. Each run creates its own tour booking, motorbike rental and shuttle booking for the status steps, so the collection can be run again and seed data is not changed. The fixed dates in December 2026 work until 20 Dec 2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tourId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tourBookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "motorbikeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shuttleId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "2. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "3. List all tours",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Has is_active', () => pm.response.json().data.forEach((tour) => pm.expect(typeof tour.is_active).to.eql('boolean')));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination. Includes inactive tours, and every tour has is_active, created_at and updated_at.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/tours?limit=50"
      }
    },
    {
      "name": "4. Filter tours (location=Hoi An, is_active=true)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Active Hoi An tours', () => data.forEach((tour) => {",
              "  pm.expect(tour.location).to.eql('Hoi An');",
              "  pm.expect(tour.is_active).to.eql(true);",
              "}));",
              "pm.test('Contains tour 2', () => pm.expect(data.map((tour) => tour.id)).to.include(2));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every tour is an active tour in Hoi An. Seed tour 2 is in the list.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/tours?location=Hoi An&is_active=true"
      }
    },
    {
      "name": "5. Create a tour",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Active, price 550000', () => {",
              "  pm.expect(data.is_active).to.eql(true);",
              "  pm.expect(data.price).to.eql(550000);",
              "  pm.expect(data.duration).to.eql('Half day');",
              "});",
              "pm.collectionVariables.set('tourId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Tour created successfully'. is_active is true by default and price is 550000. The id is saved to tourId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tours",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Son Tra Peninsula\",\n  \"description\": \"Visit Linh Ung Pagoda and look for red-shanked douc langurs.\",\n  \"location\": \"Da Nang\",\n  \"duration\": \"Half day\",\n  \"price\": 550000,\n  \"image_url\": \"https://placehold.co/800x600?text=Son+Tra\"\n}"
        }
      }
    },
    {
      "name": "6. Create with invalid data (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "description": "Empty name, missing location and duration, and a negative price. Expected: 400.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tours",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"price\": -1\n}"
        }
      }
    },
    {
      "name": "7. Update the tour (full update)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Updated and inactive', () => {",
              "  pm.expect(data.price).to.eql(900000);",
              "  pm.expect(data.is_active).to.eql(false);",
              "  pm.expect(data.description).to.eql(null);",
              "  pm.expect(data.image_url).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "PUT replaces all fields. Here is_active is false and description and image_url are not sent, so they become null. Expected: 200, message 'Tour updated successfully'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/tours/{{tourId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Son Tra Peninsula by Jeep\",\n  \"location\": \"Da Nang\",\n  \"duration\": \"1 day\",\n  \"price\": 900000,\n  \"is_active\": false\n}"
        }
      }
    },
    {
      "name": "8. Public API hides the inactive tour (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Tour not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "The tour from request 5 is now inactive. Expected: 404 with message 'Tour not found'.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tours/{{tourId}}"
      }
    },
