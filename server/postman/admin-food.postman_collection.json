              "  pm.expect(data.booking.room.room_number).to.eql('301');",
              "  pm.expect(data.items.length).to.eql(2);",
              "  pm.expect(data.items[1].line_total).to.eql(60000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200, message 'Food order retrieved successfully'. Guest Tran Thi An, room 301, 2 items.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
