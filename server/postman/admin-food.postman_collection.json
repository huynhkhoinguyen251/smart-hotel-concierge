        "url": "{{baseUrl}}/admin/menu-items/99999",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Missing\",\n  \"category\": \"food\",\n  \"price\": 1\n}"
        }
      }
    },
