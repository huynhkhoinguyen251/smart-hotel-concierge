            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 404 with message 'Menu item not found'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
