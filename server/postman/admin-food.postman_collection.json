            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/admin/menu-items/{{menuItemId}}"
      }
    },
    {
      "name": "12. Delete menu item 1, which is in orders (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 409', () => pm.response.to.have.status(409));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"This menu item is used in existing orders. Make it unavailable instead.\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Menu item 1 (Pho Bo) is used by seed food order 1. Expected: 409 with message 'This menu item is used in existing orders. Make it unavailable instead.'",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/admin/menu-items/1"
      }
    },
    {
      "name": "13. An orders food on booking 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "pm.test('Total 130000', () => pm.expect(pm.response.json().data.total_price).to.eql(130000));",
              "pm.collectionVariables.set('orderId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Creates a food order to test the status flow: Mi Quang x1 and black coffee x2. Expected: 201, status pending, total_price 130000. The id is saved to orderId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
