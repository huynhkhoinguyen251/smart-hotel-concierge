        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/food-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": 3,\n  \"items\": [\n    {\n      \"menu_item_id\": 3,\n      \"quantity\": 1\n    },\n    {\n      \"menu_item_id\": 7,\n      \"quantity\": 2\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "14. List pending food orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All pending with guest and room', () => data.forEach((order) => {",
              "  pm.expect(order.status).to.eql('pending');",
              "  pm.expect(typeof order.user.email).to.eql('string');",
              "  pm.expect(typeof order.booking.room.room_number).to.eql('string');",
              "  pm.expect(typeof order.item_count).to.eql('number');",
              "}));",
              "pm.test('Contains orderId', () => pm.expect(data.map((order) => String(order.id))).to.include(String(pm.collectionVariables.get('orderId'))));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every order is pending and includes the guest (user) with full_name and email, the room number and item_count. The order from the previous step is in the list.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/food-orders?status=pending&limit=50"
      }
    },
    {
      "name": "15. Filter by user (Pham Thu Chi's orders)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Orders of user 4', () => data.forEach((order) => pm.expect(order.user.id).to.eql(4)));",
              "pm.test('Contains seed orders', () => pm.expect(data.map((order) => order.id)).to.include.members([2, 4, 6, 7]));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every order belongs to user 4 (Pham Thu Chi). Seed orders 2, 4, 6 and 7 are in the list.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
