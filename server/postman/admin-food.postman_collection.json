{
  "info": {
    "name": "Smart Hotel - Admin Food and Drink",
    "description": "Tests the 4 admin menu item APIs and the 3 admin food order APIs. Run the requests in order (Collection Runner). The test menu item is deleted at the end of the CRUD steps, and each run adds one completed food order on seed booking 3, so the collection can be run again while booking 3 is checked in (until 6 Dec 2026).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "menuItemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as admin@smarthotel.test (test account from database/README.md). Expected: 200. The token is saved to adminToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarthotel.test\",\n  \"password\": \"Admin@123\"\n}"
        }
      }
    },
    {
      "name": "2. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "3. List all menu items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Has is_available', () => data.forEach((item) => pm.expect(typeof item.is_available).to.eql('boolean')));",
              "pm.test('Contains item 5', () => pm.expect(data.map((item) => item.id)).to.include(5));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200 with pagination. Includes unavailable item 5, and every item has is_available, created_at and updated_at.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/menu-items?limit=50"
      }
    },
    {
      "name": "4. Filter menu items (category=food, is_available=false)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Unavailable food only', () => data.forEach((item) => {",
              "  pm.expect(item.category).to.eql('food');",
              "  pm.expect(item.is_available).to.eql(false);",
              "}));",
              "pm.test('Contains item 5', () => pm.expect(data.map((item) => item.id)).to.include(5));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 200. Every item is unavailable food. Seed item 5 is in the list.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/menu-items?category=food&is_available=false"
      }
    },
    {
      "name": "5. Create a menu item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Available, price 45000', () => {",
              "  pm.expect(data.is_available).to.eql(true);",
              "  pm.expect(data.price).to.eql(45000);",
              "});",
              "pm.collectionVariables.set('menuItemId', data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Menu item created successfully'. is_available is true by default and price is 45000. The id is saved to menuItemId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/menu-items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Coconut coffee\",\n  \"category\": \"coffee\",\n  \"price\": 45000,\n  \"image_url\": \"https://placehold.co/800x600?text=Coconut+Coffee\"\n}"
        }
      }
    },
    {
      "name": "6. Create with invalid data (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "description": "Empty name, unknown category and negative price. Expected: 400.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/menu-items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"category\": \"dessert\",\n  \"price\": -1\n}"
        }
      }
    },
    {
      "name": "7. Update the menu item (full update)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Updated and unavailable', () => {",
              "  pm.expect(data.price).to.eql(50000);",
              "  pm.expect(data.is_available).to.eql(false);",
              "  pm.expect(data.image_url).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "PUT replaces all fields. Here is_available is false and image_url is not sent, so it becomes null. Expected: 200, message 'Menu item updated successfully'.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/menu-items/{{menuItemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Coconut coffee (large)\",\n  \"category\": \"coffee\",\n  \"price\": 50000,\n  \"is_available\": false\n}"
        }
      }
    },
    {
      "name": "8. Public API hides the unavailable item (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Menu item not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "The item from request 5 is now unavailable. Expected: 404 with message 'Menu item not found'.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/menu-items/{{menuItemId}}"
      }
    },
    {
      "name": "9. Update a missing menu item (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
