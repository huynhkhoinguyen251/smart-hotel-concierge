      "name": "12. Rent a motorbike for 3 days",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('3 days, total 450000', () => {",
              "  pm.expect(data.quantity).to.eql(1);",
              "  pm.expect(data.unit_price).to.eql(150000);",
              "  pm.expect(data.total_price).to.eql(450000);",
              "  pm.expect(data.service.category).to.eql('motorbike_rental');",
              "});",
              "pm.test('User cannot set the plate or a flight number', () => {",
              "  pm.expect(data.vehicle_plate).to.eql(null);",
              "  pm.expect(data.flight_number).to.eql(null);",
              "});",
              "pm.collectionVariables.set('motorbikeId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Service 6, from 2026-12-20 08:00 to 2026-12-22 10:00 (50 hours, so 3 rental days). The body also sends vehicle_plate, flight_number and unit_price; they are ignored. Expected: 201, message 'Transport booked successfully', quantity 1, unit_price 150000, total_price 450000, vehicle_plate null, flight_number null. The id is saved to motorbikeId.",
