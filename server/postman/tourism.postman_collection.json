{
  "info": {
    "name": "Smart Hotel - Tourism",
    "description": "Tests the 2 public tour APIs, the 4 user tour booking APIs and the 4 user transport booking APIs. Run the requests in order (Collection Runner). Each run creates one tour booking and three transport bookings and cancels them at the end, so the collection can be run again. The fixed dates in December 2026 work until 20 Dec 2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "anToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tourBookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "motorbikeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "airportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shuttleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login An",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('anToken', pm.response.json().data.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Logs in as an.tran@example.com (test account from database/README.md). Expected: 200. The token is saved to anToken.",
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.tran@example.com\",\n  \"password\": \"User@123\"\n}"
        }
      }
    },
    {
      "name": "2. List active tours",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Has pagination', () => pm.expect(body.pagination.page).to.eql(1));",
              "pm.test('Prices are numbers', () => body.data.forEach((tour) => pm.expect(typeof tour.price).to.eql('number')));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public, no login. Expected: 200 with pagination. Only active tours are listed, and prices are numbers. The seed data has 4 active tours.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tours?limit=50"
      }
    },
    {
      "name": "3. Filter tours by location (Da Nang)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('All in Da Nang', () => data.forEach((tour) => pm.expect(tour.location).to.eql('Da Nang')));",
              "pm.test('Contains tours 1 and 4', () => pm.expect(data.map((tour) => tour.id)).to.include.members([1, 4]));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200. Every tour is in Da Nang (exact match). Seed tours 1 and 4 are in the list.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tours?location=Da Nang"
      }
    },
    {
      "name": "4. Get tour 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Price 1250000', () => pm.expect(pm.response.json().data.price).to.eql(1250000));"
            ]
          }
        }
      ],
      "request": {
        "description": "Public. Expected: 200, message 'Tour retrieved successfully'. Ba Na Hills Discovery, price 1250000.",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tours/1"
      }
    },
    {
      "name": "5. Get a missing tour (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Message', () => pm.expect(pm.response.json().message).to.eql(\"Tour not found\"));"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 404 with message 'Tour not found'. An inactive tour gives the same result (see the admin collection).",
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tours/99999"
      }
    },
    {
      "name": "6. Book tour 1 for 2 people (20 Dec 2026)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Pending, total 2500000', () => {",
              "  pm.expect(data.status).to.eql('pending');",
              "  pm.expect(data.unit_price).to.eql(1250000);",
              "  pm.expect(data.total_price).to.eql(2500000);",
              "  pm.expect(data.tour.name).to.eql('Ba Na Hills Discovery');",
              "});",
              "pm.collectionVariables.set('tourBookingId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Expected: 201, message 'Tour booked successfully', status pending, unit_price 1250000 (from the database), total_price 2500000. A price sent in the body is ignored. The id is saved to tourBookingId.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{anToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tour-bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tour_id\": 1,\n  \"tour_date\": \"2026-12-20\",\n  \"participants\": 2,\n  \"note\": \"Vegetarian lunch for one person.\",\n  \"unit_price\": 1,\n  \"total_price\": 1\n}"
        }
      }
    },
