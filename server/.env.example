PORT=5000
# Time zone for business rules (check-in time, cancellation deadline, service schedules)
TZ=Asia/Ho_Chi_Minh
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_hotel_concierge
# Set to true when using TiDB Cloud (it only accepts TLS connections)
DB_SSL=false
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional: minutes a guest has to pay a new order (1-1440, default 15).
# Uncomment and set to 1 only to test payment expiry quickly.
# PAYMENT_HOLD_MINUTES=15
