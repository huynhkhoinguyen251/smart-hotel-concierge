    amenities ||--o{ room_type_amenities : included_in
    rooms ||--o{ room_images : has
    rooms ||--o{ bookings : reserved_by

    bookings ||--o{ service_bookings : includes
    services ||--o{ service_bookings : requested_in
    services ||--o{ transport_bookings : requested_in
    bookings ||--o{ food_orders : includes
